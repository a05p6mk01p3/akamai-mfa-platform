MFA_API_URL=http://akamai-mfa-api:8000
MFA_API_TIMEOUT=20
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_LOG_LEVEL=INFO

# CS06/CS07 trusted ingress. request_headers is refused at startup unless the
# shared-secret ingress authenticator is enabled.
MCP_TRUSTED_INGRESS_MODE=shared_secret
MCP_TRUSTED_INGRESS_HEADER_NAME=X-MFA-Ingress-Token
# Prefer a read-only mounted secret file in the MCP container.
MCP_TRUSTED_INGRESS_SECRET_FILE=/run/secrets/akamai-mfa-mcp-ingress-token
# Development fallback only; do not configure together with *_SECRET_FILE.
# MCP_TRUSTED_INGRESS_SECRET=

# Request-bound actor/session context injected by trusted LibreChat.
MCP_TRUSTED_CONTEXT_MODE=request_headers
MCP_ACTOR_HEADER_NAME=X-MFA-Actor
MCP_SESSION_HEADER_NAME=X-MFA-Session
MCP_API_ACTOR=
MCP_API_SESSION=

# Request-bound later-human attestation.
MCP_INTERACTION_ATTESTATION_MODE=request_header
MCP_INTERACTION_HEADER_NAME=X-MFA-Interaction

# Optional validation logging. Never logs ingress secret or raw context values.
MCP_LOG_ATTESTATION_PROBE=false

# Destructive lifecycle remains opt-in and fail-closed by default.
MCP_DESTRUCTIVE_EXECUTION_MODE=disabled
