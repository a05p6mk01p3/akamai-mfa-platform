AKAMAI_HOST=akab-xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx.luna.akamaiapis.net
AKAMAI_CLIENT_TOKEN=CHANGE_ME
AKAMAI_CLIENT_SECRET=CHANGE_ME
AKAMAI_ACCESS_TOKEN=CHANGE_ME
AKAMAI_CONTRACT_ID=CHANGE_ME
AKAMAI_DIRECTORY_ID=CHANGE_ME
AKAMAI_CONNECT_TIMEOUT=5
AKAMAI_READ_TIMEOUT=15
LOG_LEVEL=INFO

# PostgreSQL v2 repository (do not commit real credentials)
DATABASE_URL=postgresql://akamai_mfa:CHANGE_ME@akamai-mfa-postgres:5432/akamai_mfa
OPERATION_TTL_SECONDS=300
SAFE_REF_TTL_SECONDS=300

# Execution framework. Default is fail-closed.
# - disabled: execution framework unavailable
# - simulation: full state machine, no upstream mutation
# - live: destructive framework enabled for both supported domains; the persisted
#   operation type dispatches to the domain-local EAA or Akamai MFA adapter.
EXECUTION_BACKEND=disabled
SIMULATION_PRIMITIVE_OUTCOME=expected
SIMULATION_POSTCHECK_OUTCOME=expected

# NEVER enable live casually. MCP_DESTRUCTIVE_EXECUTION_MODE must also be enabled
# before a destructive request can proceed through the MCP layer.
# EXECUTION_BACKEND=live
