AKAMAI_HOST=akab-xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx.luna.akamaiapis.net
AKAMAI_CLIENT_TOKEN=CHANGE_ME
AKAMAI_CLIENT_SECRET=CHANGE_ME
AKAMAI_ACCESS_TOKEN=CHANGE_ME
AKAMAI_CONTRACT_ID=CHANGE_ME
AKAMAI_DIRECTORY_ID=CHANGE_ME
AKAMAI_CONNECT_TIMEOUT=5
AKAMAI_READ_TIMEOUT=15
LOG_LEVEL=INFO

# Change-set 01 is read-only and has no Operation Repository yet.
# PostgreSQL will be introduced before lifecycle/prepare/confirm/execute are enabled.


# PostgreSQL v2 repository (do not commit real credentials)
DATABASE_URL=postgresql://akamai_mfa:CHANGE_ME@akamai-mfa-postgres:5432/akamai_mfa
OPERATION_TTL_SECONDS=300
SAFE_REF_TTL_SECONDS=300


# CS06 execution state-machine validation.
# Default is fail-closed. Simulation performs no upstream mutation.
EXECUTION_BACKEND=disabled
SIMULATION_PRIMITIVE_OUTCOME=expected
SIMULATION_POSTCHECK_OUTCOME=expected


# CS07 controlled destructive tenant-validation mode.
# NEVER enable casually. This backend can issue a real EAA OTP reset POST.
# It supports EAA_NATIVE_MFA_OTP_RESET only and deliberately leaves post-check
# in VERIFYING until the tenant-specific expected state is validated.
# EXECUTION_BACKEND=eaa_validation


# CS08 controlled destructive Akamai MFA validation mode.
# This backend can DELETE exactly one backend-bound eligible device.
# EXECUTION_BACKEND=akamai_mfa_validation
