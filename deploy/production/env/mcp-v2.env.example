# Non-secret Akamai MFA MCP v2 runtime configuration.
# The trusted-ingress credential is supplied through the Podman secret
# `akamai-mfa-mcp-ingress-token` mounted at the fixed path below. Other
# deployment-specific values remain CHANGE_ME until copied from the approved
# production configuration.

MFA_API_URL=CHANGE_ME
MFA_API_TIMEOUT=CHANGE_ME
MCP_HOST=CHANGE_ME
MCP_PORT=CHANGE_ME
MCP_LOG_LEVEL=CHANGE_ME

MCP_TRUSTED_INGRESS_MODE=CHANGE_ME
MCP_TRUSTED_INGRESS_HEADER_NAME=CHANGE_ME
MCP_TRUSTED_INGRESS_SECRET_FILE=/run/secrets/akamai-mfa-mcp-ingress-token

MCP_TRUSTED_CONTEXT_MODE=CHANGE_ME
MCP_ACTOR_HEADER_NAME=CHANGE_ME
MCP_SESSION_HEADER_NAME=CHANGE_ME

MCP_INTERACTION_ATTESTATION_MODE=CHANGE_ME
MCP_INTERACTION_HEADER_NAME=CHANGE_ME
MCP_LOG_ATTESTATION_PROBE=CHANGE_ME

# Canonical production-safe release state.
MCP_DESTRUCTIVE_EXECUTION_MODE=disabled
