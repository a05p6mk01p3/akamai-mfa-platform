# Non-secret Akamai MFA MCP v2 runtime configuration.
# The trusted-ingress credential is supplied through the Podman secret
# `akamai-mfa-mcp-ingress-token` mounted at the path below.

MFA_API_URL=http://akamai-mfa-api-v2:8000
MFA_API_TIMEOUT=20
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_LOG_LEVEL=INFO

MCP_TRUSTED_INGRESS_MODE=shared_secret
MCP_TRUSTED_INGRESS_HEADER_NAME=X-MFA-Ingress-Token
MCP_TRUSTED_INGRESS_SECRET_FILE=/run/secrets/akamai-mfa-mcp-ingress-token

MCP_TRUSTED_CONTEXT_MODE=request_headers
MCP_ACTOR_HEADER_NAME=X-MFA-Actor
MCP_SESSION_HEADER_NAME=X-MFA-Session

MCP_INTERACTION_ATTESTATION_MODE=request_header
MCP_INTERACTION_HEADER_NAME=X-MFA-Interaction
MCP_LOG_ATTESTATION_PROBE=false

# Canonical production-safe release state.
MCP_DESTRUCTIVE_EXECUTION_MODE=disabled
