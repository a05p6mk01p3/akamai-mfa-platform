# Akamai MFA Platform v2 production automation configuration.
# This file MUST contain non-secret values only.
# Copy it to /etc/akamai-mfa/production.conf, replace every CHANGE_ME,
# set root:root ownership, and use mode 0600, 0640, or 0400.

# Pin the exact repository commit approved for the deployment automation bundle.
EXPECTED_REPO_COMMIT=CHANGE_ME

# PostgreSQL non-secret settings.
POSTGRES_USER=CHANGE_ME
PGDATA=CHANGE_ME
POSTGRES_DB=CHANGE_ME

# API non-secret settings. Credentials and DATABASE_URL remain Podman secrets.
AKAMAI_HOST=CHANGE_ME
AKAMAI_CONTRACT_ID=CHANGE_ME
AKAMAI_DIRECTORY_ID=CHANGE_ME
AKAMAI_CONNECT_TIMEOUT=CHANGE_ME
AKAMAI_READ_TIMEOUT=CHANGE_ME
LOG_LEVEL=CHANGE_ME
OPERATION_TTL_SECONDS=CHANGE_ME
OPERATION_EXECUTION_TIMEOUT_SECONDS=CHANGE_ME
OPERATION_RETENTION_SECONDS=CHANGE_ME
NO_PROXY=CHANGE_ME
SIMULATION_PRIMITIVE_OUTCOME=CHANGE_ME
SIMULATION_POSTCHECK_OUTCOME=CHANGE_ME

# MCP non-secret settings. The trusted-ingress credential remains a Podman secret.
MFA_API_URL=CHANGE_ME
MFA_API_TIMEOUT=CHANGE_ME
MCP_HOST=CHANGE_ME
MCP_PORT=CHANGE_ME
MCP_LOG_LEVEL=CHANGE_ME
MCP_TRUSTED_INGRESS_MODE=CHANGE_ME
MCP_TRUSTED_INGRESS_HEADER_NAME=CHANGE_ME
MCP_TRUSTED_CONTEXT_MODE=CHANGE_ME
MCP_ACTOR_HEADER_NAME=CHANGE_ME
MCP_SESSION_HEADER_NAME=CHANGE_ME
MCP_INTERACTION_ATTESTATION_MODE=CHANGE_ME
MCP_INTERACTION_HEADER_NAME=CHANGE_ME
MCP_LOG_ATTESTATION_PROBE=CHANGE_ME

# The installer writes the frozen safe-state values itself:
#   EXECUTION_BACKEND=simulation
#   MCP_DESTRUCTIVE_EXECUTION_MODE=disabled
# They are intentionally not configurable here.
